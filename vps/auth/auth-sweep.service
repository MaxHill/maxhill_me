[Unit]
Description=auth expired-row sweep
After=network.target
OnFailure=alert-on-failure@%n.service

[Service]
Type=oneshot
DynamicUser=yes
ProtectSystem=strict
PrivateTmp=yes
StateDirectory=auth
LoadCredential=config:/etc/auth/auth.prod.json
ExecStart=/opt/auth/current/auth-exe sweep ${CREDENTIALS_DIRECTORY}/config
MemoryMax=128M
