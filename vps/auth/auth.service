[Unit]
Description=auth service
After=network.target
OnFailure=alert-on-failure@%n.service

[Service]
DynamicUser=yes
ProtectSystem=strict
PrivateTmp=yes
StateDirectory=auth
LoadCredential=config:/etc/auth/auth.prod.json
ExecStart=/opt/auth/current/auth-exe ${CREDENTIALS_DIRECTORY}/config
Restart=on-failure
MemoryMax=512M

[Install]
WantedBy=multi-user.target
