[Unit]
Description=auth service
After=network.target

[Service]
DynamicUser=yes
ProtectSystem=strict
PrivateTmp=yes
StateDirectory=auth
ExecStart=/opt/auth/current/auth-exe /etc/auth/auth.prod.json
Restart=on-failure
MemoryMax=512M
OnFailure=alert-on-failure@%n.service

[Install]
WantedBy=multi-user.target
