[Unit]
Description=syncdb-server service
After=network.target
OnFailure=alert-on-failure@%n.service

[Service]
DynamicUser=yes
ProtectSystem=strict
PrivateTmp=yes
StateDirectory=sync
EnvironmentFile=/etc/sync/sync.prod.env
ExecStart=/opt/sync/current/sync-exe
Restart=on-failure
MemoryMax=512M

[Install]
WantedBy=multi-user.target
