[tools]
opam = "2.5.1"

# Canonical verbs (O(1) build interface):
#   run    — start the local built-from-source copy
#   test   — bounded automated checks (dune runtest)
#   fuzz   — unbounded checks (simulator search)
#   deploy — publish

[tasks.run]
description = "Run {{projectName}} locally and restart on source changes."
run = "dune exec --watch ./bin/main.exe"

[tasks.test]
description = "Run ocamlformat --check, then bounded dune tests."
run = "for f in $(find test -name '*.ml' -o -name '*.mli'); do ocamlformat --check \"$f\" || { echo \"ocamlformat failed: $f\"; exit 1; }; done && dune runtest --no-buffer --force"

[tasks.fuzz]
description = "Unbounded simulator search."
run = 'echo "no-op" && exit 0'

[tasks.deploy]
description = "Deploy {{projectName}}."
run = 'echo "no-op" && exit 0'
