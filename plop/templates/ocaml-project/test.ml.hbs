open Hegel

let%hegel_test greeting_is_not_empty tc =
  let name = draw tc (Generators.text ~min_size:1 ()) in
  assert (String.length ({{projectModule}}.greet name) > 8)
;;

let () =
  let files =
    Sys.argv
    |> Array.to_list
    |> List.tl
    |> List.filter (fun path -> not (Filename.check_suffix path ".pp.ml"))
  in
  greeting_is_not_empty ();
  Test_lint.run files
;;
