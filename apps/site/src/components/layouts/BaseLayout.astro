---
import "@maxhill/css";
import ThemeHead from "../ThemeHead.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    bodyClass?: string;
}

const { title, bodyClass } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <ThemeHead />
        <link rel="icon" type="image/png" href="/favicon.png?v=4" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content="#fbf3e9" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-title" content="max" />
        <title>maxhill.me - {title}</title>
        
        <!-- SEO Meta Tags -->
        <meta name="description" content="Max Hill" />
        <meta name="author" content="Max Hill" />
        
        <!-- OpenGraph Tags -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={`maxhill.me - ${title}`} />
        <meta property="og:description" content="Max hill" />
        <meta property="og:url" content="https://maxhill.me" />
        <meta property="og:site_name" content="maxhill.me" />
        
        <!-- Twitter Card Tags -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`maxhill.me - ${title}`} />
        <meta name="twitter:description" content="Max Hill" />

        <link
            rel="preload"
            href="/fonts/optimized/IBMPlexMono-Regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/optimized/IBMPlexMono-Medium.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/optimized/IBMPlexMono-Bold.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/optimized/DepartureMono-Regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <ClientRouter />
    </head>
    <body class={bodyClass}>
        <slot />
        
        <script>
            import "@maxhill/components/register-all";
        </script>
    </body>
</html>
