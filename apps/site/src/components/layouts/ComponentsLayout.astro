---
import { getAllComponentTagNames } from "../../utils/get-component-data";
import { SECTIONS } from "./sections";

interface Props {
    title?: string;
    currentComponent: string;
}

const { currentComponent } = Astro.props;
const allComponents = getAllComponentTagNames();
---

<div class="components-app">
    <aside class="components-sidebar" id="components-sidebar" role="navigation" aria-label="Components">
        <span class="sidebar-heading">Components</span>
        {allComponents.map((tagName) => (
            <a
                href={`/components/${tagName}`}
                class={`sidebar-item${tagName === currentComponent ? ' active' : ''}`}
                aria-current={tagName === currentComponent ? 'page' : undefined}
            >
                {tagName}
            </a>
        ))}
    </aside>

    <main class="components-content">
        <slot />
    </main>

    <footer class="statusbar">
        <span class="statusbar-mode" id="statusbar-mode">NORMAL</span>
        <span class="leader">space</span>
        <span><kbd>space</kbd> palette</span>
        <span class="sep">│</span>
        {SECTIONS.map((sec) => (
            <span><kbd>{sec.key}</kbd> {sec.label.toLowerCase()}</span>
        ))}
        <span class="statusbar-cursor"></span>
    </footer>
</div>

<!-- Command palette -->
<dialog id="palette-dialog" class="palette-dialog">
    <m-command-palette></m-command-palette>
</dialog>

<!-- Keyboard commands (declarative) -->
<m-command id="command_open-palette" data-label="Open command palette" command="show-modal" commandfor="#palette-dialog" keys="<Space><Space>" preventdefault>
    Open palette
</m-command>

<!-- Mobile sidebar toggle -->
<button class="sidebar-toggle" id="sidebar-toggle" aria-label="Show component list">
    Components
</button>
<div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

<style>
    :global(.component-page) {
        padding-top: var(--menu-height);
    }

    .components-app {
        display: grid;
        grid-template-columns: var(--size-fluid-9) 1fr;
        grid-template-rows: 1fr auto;
        height: calc(100dvh - var(--menu-height));
        overflow: hidden;
        background: var(--color-surface);
    }

    /* ═══════════════════════════════════════
       SIDEBAR
       ═══════════════════════════════════════ */

    .components-sidebar {
        grid-row: 1;
        grid-column: 1;
        overflow-y: auto;
        overscroll-behavior: contain;
        min-height: 0;
        padding: var(--size-2) 0;
        border-right: var(--border-width) solid var(--color-stroke);
        background: var(--color-background);
        font-family: var(--ff-display);
        display: flex;
        flex-direction: column;
    }

    .sidebar-heading {
        font-size: var(--font-size-0);
        padding: var(--size-2) var(--size-fluid-1);
        color: var(--color-text-softer);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .sidebar-item {
        font-size: var(--font-size-1);
        padding: var(--size-2) var(--size-fluid-1);
        display: block;
        text-decoration: none;
        color: var(--color-text);
        transition: background 80ms ease-out;

        &:hover {
            background: var(--color-surface);
        }

        &:focus-visible {
            outline: 2px solid var(--color-primary-fill-mid);
            outline-offset: -2px;
        }

        &.active {
            background: var(--color-surface);

            &::before {
                content: "> ";
                color: var(--color-text-link);
            }
        }
    }

    /* ═══════════════════════════════════════
       CONTENT
       ═══════════════════════════════════════ */

    .components-content {
        grid-row: 1;
        grid-column: 2;
        overflow: hidden;
        display: grid;
        min-height: 0;
    }

    /* ═══════════════════════════════════════
       STATUSBAR
       ═══════════════════════════════════════ */

    .statusbar {
        grid-column: 1 / -1;
        padding: var(--size-00) var(--size-4);
        border-top: var(--border-width) solid var(--color-stroke);
        background: var(--color-surface);
        display: flex;
        align-items: center;
        gap: var(--size-2);
        font-size: var(--font-size-0);
        font-family: var(--ff-display);
        color: var(--color-text-softer);
        height: var(--size-6);

        kbd {
            color: var(--color-primary-text-colorful);
            font-family: inherit;
            font-size: inherit;
        }

        .sep {
            color: var(--color-stroke);
            opacity: 0.5;
        }

        .leader {
            color: var(--color-text);
            font-weight: var(--font-weight-bold);
            padding-right: var(--size-1);
            border-right: var(--border-width) solid var(--color-stroke);
        }

        .statusbar-mode {
            background: var(--color-primary-fill-mid);
            color: var(--color-primary-text-on-fill);
            padding: var(--size-1) var(--size-1);
            font-weight: 700;
            letter-spacing: 0.05em;
            margin-right: var(--size-1);
        }

        .statusbar-cursor {
            margin-left: auto;
            width: 0.5ch;
            height: 1lh;
            background: var(--color-primary-text-colorful);
            animation: blink 1s step-end infinite;
        }
    }

    @keyframes blink {
        50% { opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .statusbar-cursor {
            animation: none;
        }
    }

    /* ═══════════════════════════════════════
       MOBILE
       ═══════════════════════════════════════ */

    .sidebar-toggle {
        display: none;
        position: fixed;
        bottom: var(--size-7);
        right: var(--size-2);
        z-index: 100;
        background: var(--color-surface);
        border: var(--border-width) solid var(--color-stroke);
        color: var(--color-text);
        font-family: var(--ff-display);
        font-size: var(--font-size-0);
        padding: var(--size-1) var(--size-2);
        cursor: pointer;
    }

    .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        top: var(--menu-height);
        z-index: 199;
        background: oklch(0 0 0 / 0.5);
    }

    @media (width <= 768px) {
        .components-app {
            grid-template-columns: 1fr;
        }

        .components-sidebar {
            display: none;
            position: fixed;
            inset: 0;
            top: var(--menu-height);
            z-index: 200;
            width: var(--size-fluid-9);
        }

        .sidebar-toggle {
            display: block;
        }

        .statusbar {
            display: none;
        }

        :global(.sidebar-open) .components-sidebar {
            display: flex;
        }

        :global(.sidebar-open) .sidebar-overlay {
            display: block;
        }
    }

    /* ═══════════════════════════════════════
       COMMAND PALETTE
       ═══════════════════════════════════════ */

    :global(.palette-dialog) {
        border: var(--border-width) solid var(--color-primary-fill-mid);
        background: var(--color-surface);
        color: var(--color-text);
        padding: 0;
        width: min(var(--size-content-2), 90vw);
        max-height: 50vh;
        border-radius: 0;

        &::backdrop {
            background: oklch(0 0 0 / 0.6);
            backdrop-filter: blur(var(--size-1));
        }

        m-command-palette {
            display: block;
            padding: var(--size-2);
            color: var(--color-text);
        }
    }

    /* ═══════════════════════════════════════
       LEADER ACTIVE STATE
       ═══════════════════════════════════════ */
</style>

<script>
    import "@maxhill/components/m-command-palette";
    import { registerCommand } from "@maxhill/components/m-command";
    import { SECTIONS } from "./sections";

    // ═══════════════════════════════════════
    // MOBILE SIDEBAR
    // ═══════════════════════════════════════
    const toggle = document.getElementById('sidebar-toggle');
    const overlay = document.getElementById('sidebar-overlay');

    toggle?.addEventListener('click', () => {
        document.body.classList.toggle('sidebar-open');
    });

    overlay?.addEventListener('click', () => {
        document.body.classList.remove('sidebar-open');
    });

    // ═══════════════════════════════════════
    // COMMAND PALETTE
    // ═══════════════════════════════════════
    const paletteDialog = document.getElementById('palette-dialog') as HTMLDialogElement;

    // Force palette to re-render when opened (ensures all commands are listed)
    const paletteCommand = document.getElementById('command_open-palette');
    paletteCommand?.addEventListener('m-command-trigger', () => {
        document.dispatchEvent(new CustomEvent('m-command-register', { bubbles: true, composed: true }));
    });

    document.addEventListener('m-command-trigger', (e) => {
        // Close palette when a command is triggered from within it, not when opening it
        const target = e.target as HTMLElement;
        if (paletteDialog?.open && target.id !== 'command_open-palette') {
            paletteDialog.close();
        }
    });

    // Register component navigation commands
    const sidebarLinks = document.querySelectorAll('.sidebar-item');
    sidebarLinks.forEach((link) => {
        const href = link.getAttribute('href');
        const tagName = href?.split('/').pop();
        if (tagName) {
            registerCommand({
                id: `go-to-${tagName}`,
                command: "navigate",
                commandfor: href!,
            });
            const el = document.getElementById(`command_go-to-${tagName}`);
            if (el) el.dataset.label = `Navigate to ${tagName}`;
        }
    });

    // Register section commands
    SECTIONS.forEach(({ id, key, label }) => {
        registerCommand({
            id: `section-${id}`,
            keys: `<Space>${key}`,
            preventDefault: true,
            customCommand: () => {
                const tabList = document.querySelector('m-tab-list.section-tabs');
                if (tabList) {
                    const tab = tabList.querySelector(`m-tab[panel="${id}"]`) as HTMLElement;
                    if (tab && !tab.hasAttribute('disabled')) {
                        tab.click();
                    }
                }
            }
        });
        const el = document.getElementById(`command_section-${id}`);
        if (el) el.dataset.label = `Show ${label}`;
    });
</script>
