---
/**
 * PROTOTYPE v2 — Split Pane (code editor style)
 * Uses m-tab-list with position="start" for sidebar navigation.
 * Delete when direction is chosen.
 */
import PageLayout from "../../components/layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import {
    getComponentByTagName,
    getComponentPublicProperties,
    getComponentPublicMethods,
    getComponentEventsWithType,
} from "@wc-toolkit/cem-utilities";
import customElements from "@maxhill/components/custom-elements.json";

const docEntries = await getCollection("componentDocs");

const components = docEntries.map((docsEntry) => {
  const tagName = docsEntry.id.split("/").slice(-2, -1)[0];
  const comp = getComponentByTagName(customElements, tagName);
  return {
    tagName,
    component: comp,
    properties: comp ? getComponentPublicProperties(comp) : [],
    methods: comp ? getComponentPublicMethods(comp) : [],
    events: comp ? getComponentEventsWithType(comp, { overrideCustomEventType: true }) : [],
    slots: comp?.slots || [],
    cssParts: comp?.cssParts || [],
    formAssociated: comp?.members?.some((m: any) => m.name === "formAssociated" && m.static === true && m.default === "true") ?? false,
  };
});

const filteredComponents = components.filter(c => c.tagName);
const defaultComponent = filteredComponents.find(c => c.tagName === "m-listbox") || filteredComponents[0];
---

<PageLayout title="PROTOTYPE v2: Split Pane" bodyClass="proto-v2-page">
  <nav class="proto-nav">
    <span class="proto-label">PROTOTYPE</span>
    <a href="/components/prototype-v1">v1: Accordion</a>
    <a href="/components/prototype-v2" class="active">v2: Split Pane</a>
    <a href="/components/prototype-v3">v3: Tabs</a>
    <a href="/components/prototype-v4">v4: Sidebar+Accordion</a>
  </nav>

  <div class="app">
    <m-tab-list position="start" tab={defaultComponent.tagName} label="Component navigation" class="tab-container">
      {filteredComponents.map(comp => (
        <m-tab panel={comp.tagName}>{comp.tagName}</m-tab>
      ))}

      {filteredComponents.map(comp => (
        <m-tab-panel name={comp.tagName}>
          <div class="panel-header">
            <span class="filename">&lt;{comp.tagName}&gt;</span>
            <span class="badges">
              {comp.formAssociated && <span class="badge">FORM</span>}
              {comp.slots.length > 0 && <span class="badge">{comp.slots.length} SLOTS</span>}
              <span class="badge">{comp.properties.length} PROPS</span>
            </span>
          </div>

          <div class="panel-content">
            <div class="api-section typesetting">
              <h3 class="api-title">── Overview ──</h3>
              <p>{comp.component?.description?.split("\n")[0] || "No description."}</p>
              <pre><code>&lt;{comp.tagName} name="example"&gt;
  &lt;m-option value="one"&gt;Option One&lt;/m-option&gt;
&lt;/{comp.tagName}&gt;</code></pre>
            </div>

            <div class="api-section typesetting">
              <h3 class="api-title">── Examples ──</h3>
              <p>Form participation, validation, selection modes, and keyboard navigation examples.</p>
            </div>

            {comp.properties.length > 0 && (
              <div class="api-section">
                <h3 class="api-title">── Properties ──</h3>
                <table>
                  <thead><tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                  <tbody>
                    {comp.properties.map((prop: any) => (
                      <tr>
                        <td class="cell-name">{prop.name}</td>
                        <td class="cell-type">{prop.type?.text || "—"}</td>
                        <td class="cell-default">{prop.default || "—"}</td>
                        <td>{prop.description || "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {comp.methods.length > 0 && (
              <div class="api-section">
                <h3 class="api-title">── Methods ──</h3>
                <table>
                  <thead><tr><th>Name</th><th>Type</th><th>Description</th></tr></thead>
                  <tbody>
                    {comp.methods.map((method: any) => (
                      <tr>
                        <td class="cell-name">{method.name}</td>
                        <td class="cell-type">{method.type?.text || "—"}</td>
                        <td>{method.description || "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {comp.events.length > 0 && (
              <div class="api-section">
                <h3 class="api-title">── Events ──</h3>
                <table>
                  <thead><tr><th>Name</th><th>Detail Type</th><th>Description</th></tr></thead>
                  <tbody>
                    {comp.events.map((event: any) => (
                      <tr>
                        <td class="cell-name">{event.name}</td>
                        <td class="cell-type">{event.type?.text || "—"}</td>
                        <td>{event.description || "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {comp.slots.length > 0 && (
              <div class="api-section">
                <h3 class="api-title">── Slots ──</h3>
                <table>
                  <thead><tr><th>Name</th><th>Description</th></tr></thead>
                  <tbody>
                    {comp.slots.map((slot: any) => (
                      <tr>
                        <td class="cell-name">{slot.name || "(default)"}</td>
                        <td>{slot.description || "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {comp.cssParts.length > 0 && (
              <div class="api-section">
                <h3 class="api-title">── CSS Parts ──</h3>
                <table>
                  <thead><tr><th>Name</th><th>Description</th></tr></thead>
                  <tbody>
                    {comp.cssParts.map((part: any) => (
                      <tr>
                        <td class="cell-name">::part({part.name})</td>
                        <td>{part.description || "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </m-tab-panel>
      ))}
    </m-tab-list>

    <footer class="statusbar">
      <span><kbd>j</kbd><kbd>k</kbd> navigate</span>
      <span><kbd>/</kbd> filter</span>
      <span><kbd>Enter</kbd> select</span>
      <span class="sep">│</span>
      <span class="mode">NORMAL</span>
    </footer>
  </div>
</PageLayout>

<style>
  :global(.proto-v2-page) {
    padding-top: var(--menu-height);
  }

  .proto-nav {
    position: fixed;
    bottom: 60px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    gap: var(--size-1);
    align-items: center;
    padding: var(--size-1) var(--size-2);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-stroke);
    font-size: var(--font-size-0);

    .proto-label {
      color: var(--color-destructive-text-colorful);
      font-weight: bold;
      font-family: var(--ff-display);
    }

    a {
      padding: var(--size-00) var(--size-1);
      text-decoration: none;
      color: var(--color-text-softer);
      &.active {
        background: var(--color-primary-fill-softer);
        color: var(--color-primary-text-colorful);
      }
    }
  }

  .app {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: calc(100dvh - var(--menu-height));
  }

  .tab-container {
    min-height: 0;
    overflow: hidden;

    &::part(tab) {
      overflow-y: auto;
      padding: var(--size-1) 0;
      min-width: 180px;
      border-right: var(--border-width) solid var(--color-stroke);
    }

    m-tab {
      font-size: var(--font-size-0);
      padding: var(--size-00) var(--size-2);
      display: block;
      cursor: pointer;

      &:hover {
        background: var(--color-primary-fill-softer);
      }

      &[active] {
        background: var(--color-primary-fill-softer);
        color: var(--color-primary-text-colorful);
      }
    }

    m-tab-panel {
      overflow-y: auto;
      display: grid;
      grid-template-rows: auto 1fr;
    }
  }

  .panel-header {
    padding: var(--size-1) var(--size-2);
    border-bottom: var(--border-width) solid var(--color-stroke);
    display: flex;
    align-items: center;
    gap: var(--size-2);
  }

  .filename {
    font-family: var(--ff-display);
    font-size: 1.25rem;
    color: var(--color-primary-text-colorful);
  }

  .badge {
    font-size: 0.6875rem;
    padding: 0 var(--size-1);
    border: var(--border-width) solid var(--color-stroke);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-softer);
  }

  .panel-content {
    overflow-y: auto;
    padding: var(--size-2);
  }

  .api-section {
    margin-bottom: var(--size-3);
  }

  .api-title {
    font: var(--p2);
    color: var(--color-text-softer);
    margin: 0 0 var(--size-1) 0;
    font-family: var(--ff-display);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-0);

    th, td {
      text-align: left;
      padding: var(--size-00) var(--size-2) var(--size-00) 0;
      border-bottom: var(--border-width) solid var(--color-stroke);
    }

    th {
      font-weight: var(--font-weight-medium);
      color: var(--color-text-softer);
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
    }
  }

  .cell-name {
    color: var(--color-primary-text-colorful);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }

  .cell-type {
    color: var(--color-text-softer);
    white-space: nowrap;
  }

  .cell-default {
    color: var(--color-text-softer);
    font-style: italic;
  }

  .statusbar {
    padding: var(--size-1) var(--size-2);
    border-top: var(--border-width) solid var(--color-stroke);
    background: var(--color-surface);
    display: flex;
    gap: var(--size-3);
    font-size: var(--font-size-0);
    color: var(--color-text-softer);

    kbd {
      color: var(--color-primary-text-colorful);
      font-family: var(--ff-display);
    }

    .sep { color: var(--color-stroke); }
    .mode {
      margin-left: auto;
      color: var(--color-constructive-text-colorful, var(--color-primary-text-colorful));
      font-weight: var(--font-weight-bold);
    }
  }
</style>
