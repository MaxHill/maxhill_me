---
/**
 * PROTOTYPE v1 — Accordion TUI
 * Full-page collapsible sections with keyboard shortcuts.
 * Uses m-command for keybindings. All data is real.
 * Delete when direction is chosen.
 */
import PageLayout from "../../components/layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import {
    getComponentByTagName,
    getComponentPublicProperties,
    getComponentPublicMethods,
    getComponentEventsWithType,
} from "@wc-toolkit/cem-utilities";
import customElements from "@maxhill/components/custom-elements.json";

import { render } from "astro:content";

const docEntries = await getCollection("componentDocs");

const components = docEntries.map((docsEntry) => {
  const tagName = docsEntry.id.split("/").slice(-2, -1)[0];
  const comp = getComponentByTagName(customElements, tagName);
  return {
    tagName,
    component: comp,
    properties: comp ? getComponentPublicProperties(comp) : [],
    methods: comp ? getComponentPublicMethods(comp) : [],
    events: comp ? getComponentEventsWithType(comp, { overrideCustomEventType: true }) : [],
    slots: comp?.slots || [],
    cssParts: comp?.cssParts || [],
    formAssociated: comp?.members?.some((m: any) => m.name === "formAssociated" && m.static === true && m.default === "true") ?? false,
  };
}).filter(c => c.tagName);

// Use URL param to pick component, default to m-listbox
const url = new URL(Astro.request.url);
const selectedTag = url.searchParams.get("c") || "m-listbox";
const current = components.find(c => c.tagName === selectedTag) || components[0];
const currentIndex = components.indexOf(current);
const prevComponent = components[(currentIndex - 1 + components.length) % components.length];
const nextComponent = components[(currentIndex + 1) % components.length];
---

<PageLayout title="PROTOTYPE v1: Accordion TUI" bodyClass="proto-v1-page">
  <nav class="proto-nav">
    <span class="proto-label">PROTOTYPE</span>
    <a href="/components/prototype-v1" class="active">v1: Accordion</a>
    <a href="/components/prototype-v2">v2: Split Pane</a>
    <a href="/components/prototype-v3">v3: Tabs</a>
    <a href="/components/prototype-v4">v4: Sidebar+Accordion</a>
  </nav>

  <div class="app">
    <header class="header">
      <span class="component-name">&lt;{current.tagName}&gt;</span>
      <span class="meta">
        {current.formAssociated && "form-associated · "}
        {current.slots.length} slots · {current.properties.length} props
      </span>
      <span class="nav-hint">
        <a href={`?c=${prevComponent.tagName}`} class="nav-link">← {prevComponent.tagName}</a>
        <a href={`?c=${nextComponent.tagName}`} class="nav-link">{nextComponent.tagName} →</a>
      </span>
    </header>

    <main class="main">
      <section class="section" data-key="o" data-expanded="true">
        <h2 class="section-header">
          <span class="key-hint">o</span>verview
          <span class="count"></span>
        </h2>
        <div class="section-content typesetting">
          <p>{current.component?.description || "No description available."}</p>
          <h3>Basic Usage</h3>
          <pre><code>&lt;{current.tagName} name="example"&gt;
  &lt;m-option value="one"&gt;Option One&lt;/m-option&gt;
  &lt;m-option value="two"&gt;Option Two&lt;/m-option&gt;
&lt;/{current.tagName}&gt;</code></pre>
        </div>
      </section>

      <section class="section" data-key="x">
        <h2 class="section-header">
          e<span class="key-hint">x</span>amples
          <span class="count"></span>
        </h2>
        <div class="section-content typesetting">
          <h3>Form Participation</h3>
          <p>This component is {current.formAssociated ? "" : "not "}form-associated{current.formAssociated ? " — it participates in form submission, responds to reset(), and supports constraint validation." : "."}</p>
          <pre><code>&lt;form&gt;
  &lt;{current.tagName} name="field" required&gt;
    &lt;m-option value="a"&gt;Alpha&lt;/m-option&gt;
    &lt;m-option value="b"&gt;Beta&lt;/m-option&gt;
  &lt;/{current.tagName}&gt;
  &lt;button type="submit"&gt;Submit&lt;/button&gt;
&lt;/form&gt;</code></pre>
          <h3>Selection Modes</h3>
          <p>Supports <code>single-select</code> (default), <code>single-focus</code>, and <code>multiple</code> modes via the <code>mode</code> attribute.</p>
        </div>
      </section>

      <section class="section" data-key="k">
        <h2 class="section-header">
          <span class="key-hint">k</span>eyboard
          <span class="count"></span>
        </h2>
        <div class="section-content">
          <table>
            <thead><tr><th>Key</th><th>Action</th></tr></thead>
            <tbody>
              <tr><td class="cell-name">↑ / ↓</td><td>Move focus / selection</td></tr>
              <tr><td class="cell-name">Home / End</td><td>Jump to first / last</td></tr>
              <tr><td class="cell-name">Space / Enter</td><td>Select focused option</td></tr>
              <tr><td class="cell-name">Escape</td><td>Clear / close</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section" data-key="p">
        <h2 class="section-header">
          <span class="key-hint">p</span>roperties
          <span class="count">{current.properties.length}</span>
        </h2>
        <div class="section-content">
          {current.properties.length > 0 ? (
            <table>
              <thead><tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
              <tbody>
                {current.properties.map((prop: any) => (
                  <tr>
                    <td class="cell-name">{prop.name}</td>
                    <td class="cell-type">{prop.type?.text || "—"}</td>
                    <td class="cell-default">{prop.default || "—"}</td>
                    <td>{prop.description || "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="empty">No properties defined</p>
          )}
        </div>
      </section>

      <section class="section" data-key="m">
        <h2 class="section-header">
          <span class="key-hint">m</span>ethods
          <span class="count">{current.methods.length}</span>
        </h2>
        <div class="section-content">
          {current.methods.length > 0 ? (
            <table>
              <thead><tr><th>Name</th><th>Type</th><th>Description</th></tr></thead>
              <tbody>
                {current.methods.map((method: any) => (
                  <tr>
                    <td class="cell-name">{method.name}</td>
                    <td class="cell-type">{method.type?.text || "—"}</td>
                    <td>{method.description || "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="empty">No methods defined</p>
          )}
        </div>
      </section>

      <section class="section" data-key="e">
        <h2 class="section-header">
          <span class="key-hint">e</span>vents
          <span class="count">{current.events.length}</span>
        </h2>
        <div class="section-content">
          {current.events.length > 0 ? (
            <table>
              <thead><tr><th>Name</th><th>Detail Type</th><th>Description</th></tr></thead>
              <tbody>
                {current.events.map((event: any) => (
                  <tr>
                    <td class="cell-name">{event.name}</td>
                    <td class="cell-type">{event.type?.text || "—"}</td>
                    <td>{event.description || "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="empty">No events defined</p>
          )}
        </div>
      </section>

      <section class="section" data-key="s">
        <h2 class="section-header">
          <span class="key-hint">s</span>lots
          <span class="count">{current.slots.length}</span>
        </h2>
        <div class="section-content">
          {current.slots.length > 0 ? (
            <table>
              <thead><tr><th>Name</th><th>Description</th></tr></thead>
              <tbody>
                {current.slots.map((slot: any) => (
                  <tr>
                    <td class="cell-name">{slot.name || "(default)"}</td>
                    <td>{slot.description || "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="empty">No slots defined</p>
          )}
        </div>
      </section>

      <section class="section" data-key="c">
        <h2 class="section-header">
          <span class="key-hint">c</span>ss parts
          <span class="count">{current.cssParts.length}</span>
        </h2>
        <div class="section-content">
          {current.cssParts.length > 0 ? (
            <table>
              <thead><tr><th>Name</th><th>Description</th></tr></thead>
              <tbody>
                {current.cssParts.map((part: any) => (
                  <tr>
                    <td class="cell-name">::part({part.name})</td>
                    <td>{part.description || "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="empty">No CSS parts defined</p>
          )}
        </div>
      </section>
    </main>

    <footer class="statusbar">
      <span class="leader">ctrl+b</span>
      <span><kbd>o</kbd>verview</span>
      <span>e<kbd>x</kbd>amples</span>
      <span><kbd>k</kbd>eyboard</span>
      <span><kbd>p</kbd>rops</span>
      <span><kbd>m</kbd>ethods</span>
      <span><kbd>e</kbd>vents</span>
      <span><kbd>s</kbd>lots</span>
      <span><kbd>c</kbd>ss parts</span>
      <span class="sep">│</span>
      <span><kbd>[</kbd><kbd>]</kbd> prev/next</span>
    </footer>
  </div>

  <m-command keys="<C-b>[" command="navigate" commandfor={`/components/prototype-v1?c=${prevComponent.tagName}`}></m-command>
  <m-command keys="<C-b>]" command="navigate" commandfor={`/components/prototype-v1?c=${nextComponent.tagName}`}></m-command>
</PageLayout>

<script>
  import { registerCommand } from "@maxhill/components/m-command";

  const sections = document.querySelectorAll('.section');
  const keyMap: Record<string, HTMLElement> = {};

  sections.forEach(s => {
    const key = (s as HTMLElement).dataset.key;
    if (key) keyMap[key] = s as HTMLElement;
  });

  function expandSection(section: HTMLElement) {
    sections.forEach(s => {
      (s as HTMLElement).dataset.expanded = "false";
    });
    section.dataset.expanded = "true";
    section.scrollIntoView({ behavior: "instant", block: "nearest" });
  }

  sections.forEach(s => {
    s.querySelector('.section-header')?.addEventListener('click', () => expandSection(s as HTMLElement));
  });

  // Register keyboard commands programmatically
  const sectionKeys = ['o', 'x', 'k', 'p', 'm', 'e', 's', 'c'];
  sectionKeys.forEach(key => {
    registerCommand({
      keys: `<C-b>${key}`,
      command: "custom",
      customCommand: () => {
        if (keyMap[key]) expandSection(keyMap[key]);
      }
    });
  });
</script>

<style>
  :global(.proto-v1-page) {
    padding-top: var(--menu-height);
  }

  .proto-nav {
    position: fixed;
    bottom: 60px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    gap: var(--size-1);
    align-items: center;
    padding: var(--size-1) var(--size-2);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-stroke);
    font-size: var(--font-size-0);

    .proto-label {
      color: var(--color-destructive-text-colorful);
      font-weight: bold;
      font-family: var(--ff-display);
    }

    a {
      padding: var(--size-00) var(--size-1);
      text-decoration: none;
      color: var(--color-text-softer);
      &.active {
        background: var(--color-primary-fill-softer);
        color: var(--color-primary-text-colorful);
      }
    }
  }

  .app {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100dvh - var(--menu-height));
  }

  .header {
    padding: var(--size-2) var(--size-3);
    border-bottom: var(--border-width) solid var(--color-stroke);
    display: flex;
    align-items: baseline;
    gap: var(--size-3);
    flex-wrap: wrap;
  }

  .component-name {
    font-family: var(--ff-display);
    font-size: 1.5rem;
    color: var(--color-primary-text-colorful);
  }

  .meta {
    font-size: var(--font-size-0);
    color: var(--color-text-softer);
  }

  .nav-hint {
    margin-left: auto;
    display: flex;
    gap: var(--size-2);
    font-size: var(--font-size-0);
  }

  .nav-link {
    color: var(--color-text-softer);
    text-decoration: none;
    &:hover { color: var(--color-primary-text-colorful); }
  }

  .main {
    overflow-y: auto;
  }

  .section {
    border-bottom: var(--border-width) solid var(--color-stroke);
  }

  .section-header {
    font: var(--p);
    font-weight: var(--font-weight-medium);
    margin: 0;
    padding: var(--size-1) var(--size-3);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--size-2);
    user-select: none;

    &:hover {
      background: var(--color-primary-fill-softer);
    }
  }

  .key-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5em;
    height: 1.5em;
    border: var(--border-width) solid var(--color-stroke);
    font-family: var(--ff-display);
    font-size: var(--font-size-0);
    color: var(--color-primary-text-colorful);
  }

  .count {
    margin-left: auto;
    font-size: var(--font-size-0);
    color: var(--color-text-softer);
  }

  .section-content {
    display: none;
    padding: 0 var(--size-3) var(--size-2);
    overflow-x: auto;
  }

  .section[data-expanded="true"] .section-content {
    display: block;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-0);

    th, td {
      text-align: left;
      padding: var(--size-00) var(--size-2) var(--size-00) 0;
      border-bottom: var(--border-width) solid var(--color-stroke);
    }

    th {
      font-weight: var(--font-weight-medium);
      color: var(--color-text-softer);
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      padding-bottom: var(--size-1);
    }
  }

  .cell-name {
    font-weight: var(--font-weight-medium);
    color: var(--color-primary-text-colorful);
    white-space: nowrap;
  }

  .cell-type {
    color: var(--color-text-softer);
    white-space: nowrap;
  }

  .cell-default {
    color: var(--color-text-softer);
    font-style: italic;
  }

  .empty {
    color: var(--color-text-softer);
    font-style: italic;
    margin: 0;
  }

  .statusbar {
    padding: var(--size-1) var(--size-3);
    border-top: var(--border-width) solid var(--color-stroke);
    background: var(--color-surface);
    display: flex;
    gap: var(--size-3);
    font-size: var(--font-size-0);
    color: var(--color-text-softer);
    position: sticky;
    bottom: 0;

    kbd {
      color: var(--color-primary-text-colorful);
      font-family: var(--ff-display);
      font-size: inherit;
    }

    .sep {
      color: var(--color-stroke);
    }

    .leader {
      color: var(--color-text);
      font-weight: var(--font-weight-bold);
      padding-right: var(--size-1);
      border-right: var(--border-width) solid var(--color-stroke);
    }
  }
</style>
