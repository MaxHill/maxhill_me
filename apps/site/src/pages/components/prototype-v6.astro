---
/**
 * PROTOTYPE v6 — Terminal Overdrive
 * Based on v5 (sidebar + top tabs) with:
 * - CRT boot sequence on first load (~500ms scanline sweep + char reveal)
 * - Spring-physics block cursor sliding between sidebar items
 * - Terminal wipe transition on tab switch (left-to-right redraw)
 * Delete when direction is chosen.
 */
import PageLayout from "../../components/layouts/PageLayout.astro";
import CodeExample from "../../components/CodeExample.astro";
import { getCollection, render } from "astro:content";
import {
    getComponentByTagName,
    getComponentPublicProperties,
    getComponentPublicMethods,
    getComponentEventsWithType,
} from "@wc-toolkit/cem-utilities";
import customElements from "@maxhill/components/custom-elements.json";

const docEntries = await getCollection("componentDocs");
const overviewEntries = await getCollection("componentOverview");
const examplesEntries = await getCollection("componentExamples");
const keyboardEntries = await getCollection("componentKeyboard");

const components = docEntries.map((docsEntry) => {
  const tagName = docsEntry.id.split("/").slice(-2, -1)[0];
  const comp = getComponentByTagName(customElements, tagName);
  
  const overview = overviewEntries.find(e => e.id.includes(tagName));
  const examples = examplesEntries.find(e => e.id.includes(tagName));
  const keyboard = keyboardEntries.find(e => e.id.includes(tagName));
  
  return {
    tagName,
    component: comp,
    properties: comp ? getComponentPublicProperties(comp) : [],
    methods: comp ? getComponentPublicMethods(comp) : [],
    events: comp ? getComponentEventsWithType(comp, { overrideCustomEventType: true }) : [],
    slots: comp?.slots || [],
    cssParts: comp?.cssParts || [],
    formAssociated: comp?.members?.some((m: any) => m.name === "formAssociated" && m.static === true && m.default === "true") ?? false,
    overview,
    examples,
    keyboard,
  };
}).filter(c => c.tagName);

const renderedContent = new Map<string, {
  overview?: Awaited<ReturnType<typeof render>>,
  examples?: Awaited<ReturnType<typeof render>>,
  keyboard?: Awaited<ReturnType<typeof render>>,
}>();
for (const comp of components) {
  const rendered: any = {};
  if (comp.overview) rendered.overview = await render(comp.overview);
  if (comp.examples) rendered.examples = await render(comp.examples);
  if (comp.keyboard) rendered.keyboard = await render(comp.keyboard);
  renderedContent.set(comp.tagName, rendered);
}

const defaultComponent = components.find(c => c.tagName === "m-listbox") || components[0];

const sections = [
  { key: "o", id: "overview", label: "overview" },
  { key: "x", id: "examples", label: "examples" },
  { key: "y", id: "keyboard", label: "keyboard" },
  { key: "p", id: "properties", label: "properties" },
  { key: "m", id: "methods", label: "methods" },
  { key: "e", id: "events", label: "events" },
  { key: "s", id: "slots", label: "slots" },
  { key: "c", id: "css-parts", label: "css parts" },
];
---

<PageLayout title="PROTOTYPE v6: Terminal Overdrive" bodyClass="proto-v6-page">
  <nav class="proto-nav">
    <span class="proto-label">PROTOTYPE</span>
    <a href="/components/prototype-v1">v1</a>
    <a href="/components/prototype-v2">v2</a>
    <a href="/components/prototype-v3">v3</a>
    <a href="/components/prototype-v4">v4</a>
    <a href="/components/prototype-v5">v5</a>
    <a href="/components/prototype-v6" class="active">v6: Overdrive</a>
  </nav>

  <!-- Boot overlay -->
  <div class="boot-overlay" id="boot-overlay" aria-hidden="true">
    <div class="boot-scanline"></div>
    <pre class="boot-text" id="boot-text"></pre>
  </div>

  <div class="app" id="app">
    <aside class="sidebar" role="listbox" aria-label="Components">
      <div class="sidebar-cursor" id="sidebar-cursor"></div>
      {components.map((comp, i) => (
        <button
          class={`sidebar-item${comp.tagName === defaultComponent.tagName ? ' active' : ''}`}
          data-component={comp.tagName}
          role="option"
          aria-selected={comp.tagName === defaultComponent.tagName ? 'true' : 'false'}
        >
          <span class="sidebar-index">{String(i + 1).padStart(2, '0')}</span>
          {comp.tagName}
        </button>
      ))}
    </aside>

    <main class="content">
      {components.map((comp) => (
        <article
          class={`component-view${comp.tagName === defaultComponent.tagName ? ' active' : ''}`}
          data-component={comp.tagName}
        >
          <header class="component-header">
            <span class="component-name">&lt;{comp.tagName}&gt;</span>
            <span class="badges">
              {comp.formAssociated && <span class="badge badge--form">FORM</span>}
              {comp.slots.length > 0 && <span class="badge">{comp.slots.length} SLOTS</span>}
              {comp.properties.length > 0 && <span class="badge">{comp.properties.length} PROPS</span>}
              {comp.events.length > 0 && <span class="badge">{comp.events.length} EVENTS</span>}
            </span>
          </header>

          <nav class="section-tabs" role="tablist" aria-label="Component sections">
            {sections.map((sec, i) => (
              <button
                class={`section-tab${i === 0 ? ' active' : ''}`}
                data-section={sec.id}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`${comp.tagName}-${sec.id}`}
              >
                <span class="tab-key" aria-hidden="true">{sec.key}</span>
                {sec.label}
              </button>
            ))}
          </nav>

          <div class="section-panels">
            <div class="section-panel active" data-section="overview" id={`${comp.tagName}-overview`} role="tabpanel">
              <div class="panel-inner typesetting">
                {renderedContent.get(comp.tagName)?.overview ? (
                  <>{(() => { const C = renderedContent.get(comp.tagName)!.overview!.Content; return <C />; })()}</>
                ) : (
                  <>
                    <p>{comp.component?.description?.split("\n")[0] || "No description."}</p>
                    <CodeExample html={`<${comp.tagName} name="example">\n  <m-option value="one">Option One</m-option>\n  <m-option value="two">Option Two</m-option>\n</${comp.tagName}>`} />
                  </>
                )}
              </div>
            </div>

            <div class="section-panel" data-section="examples" id={`${comp.tagName}-examples`} role="tabpanel">
              <div class="panel-inner typesetting">
                {renderedContent.get(comp.tagName)?.examples ? (
                  <>{(() => { const C = renderedContent.get(comp.tagName)!.examples!.Content; return <C />; })()}</>
                ) : (
                  <>
                    <h3>Form Participation</h3>
                    <CodeExample html={`<form>\n  <${comp.tagName} name="field" required>\n    <m-option value="a">Alpha</m-option>\n  </${comp.tagName}>\n  <button type="submit">Submit</button>\n</form>`} />
                  </>
                )}
              </div>
            </div>

            <div class="section-panel" data-section="keyboard" id={`${comp.tagName}-keyboard`} role="tabpanel">
              <div class="panel-inner typesetting">
                {renderedContent.get(comp.tagName)?.keyboard ? (
                  <>{(() => { const C = renderedContent.get(comp.tagName)!.keyboard!.Content; return <C />; })()}</>
                ) : (
                  <table>
                    <thead><tr><th>Key</th><th>Action</th></tr></thead>
                    <tbody>
                      <tr><td class="cell-name">↑ / ↓</td><td>Move focus / selection</td></tr>
                      <tr><td class="cell-name">Home / End</td><td>Jump to first / last</td></tr>
                      <tr><td class="cell-name">Space / Enter</td><td>Select focused option</td></tr>
                      <tr><td class="cell-name">Escape</td><td>Clear / close</td></tr>
                    </tbody>
                  </table>
                )}
              </div>
            </div>

            <div class="section-panel" data-section="properties" id={`${comp.tagName}-properties`} role="tabpanel">
              <div class="panel-inner">
                {comp.properties.length > 0 ? (
                  <table>
                    <thead><tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                    <tbody>
                      {comp.properties.map((prop: any) => (
                        <tr>
                          <td class="cell-name">{prop.name}</td>
                          <td class="cell-type">{prop.type?.text || "—"}</td>
                          <td class="cell-default">{prop.default || "—"}</td>
                          <td>{prop.description || "—"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <p class="empty">No properties defined</p>
                )}
              </div>
            </div>

            <div class="section-panel" data-section="methods" id={`${comp.tagName}-methods`} role="tabpanel">
              <div class="panel-inner">
                {comp.methods.length > 0 ? (
                  <table>
                    <thead><tr><th>Name</th><th>Type</th><th>Description</th></tr></thead>
                    <tbody>
                      {comp.methods.map((method: any) => (
                        <tr>
                          <td class="cell-name">{method.name}</td>
                          <td class="cell-type">{method.type?.text || "—"}</td>
                          <td>{method.description || "—"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <p class="empty">No methods defined</p>
                )}
              </div>
            </div>

            <div class="section-panel" data-section="events" id={`${comp.tagName}-events`} role="tabpanel">
              <div class="panel-inner">
                {comp.events.length > 0 ? (
                  <table>
                    <thead><tr><th>Name</th><th>Detail Type</th><th>Description</th></tr></thead>
                    <tbody>
                      {comp.events.map((event: any) => (
                        <tr>
                          <td class="cell-name">{event.name}</td>
                          <td class="cell-type">{event.type?.text || "—"}</td>
                          <td>{event.description || "—"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <p class="empty">No events defined</p>
                )}
              </div>
            </div>

            <div class="section-panel" data-section="slots" id={`${comp.tagName}-slots`} role="tabpanel">
              <div class="panel-inner">
                {comp.slots.length > 0 ? (
                  <table>
                    <thead><tr><th>Name</th><th>Description</th></tr></thead>
                    <tbody>
                      {comp.slots.map((slot: any) => (
                        <tr>
                          <td class="cell-name">{slot.name || "(default)"}</td>
                          <td>{slot.description || "—"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <p class="empty">No slots defined</p>
                )}
              </div>
            </div>

            <div class="section-panel" data-section="css-parts" id={`${comp.tagName}-css-parts`} role="tabpanel">
              <div class="panel-inner">
                {comp.cssParts.length > 0 ? (
                  <table>
                    <thead><tr><th>Name</th><th>Description</th></tr></thead>
                    <tbody>
                      {comp.cssParts.map((part: any) => (
                        <tr>
                          <td class="cell-name">::part({part.name})</td>
                          <td>{part.description || "—"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <p class="empty">No CSS parts defined</p>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </main>

    <dialog id="palette-dialog" class="palette-dialog">
      <m-command-palette></m-command-palette>
    </dialog>

    <footer class="statusbar">
      <span class="statusbar-mode">NORMAL</span>
      <span class="leader">C-b</span>
      <span><kbd>space</kbd> palette</span>
      <span class="sep">│</span>
      <span><kbd>o</kbd> overview</span>
      <span><kbd>x</kbd> examples</span>
      <span><kbd>y</kbd> keyboard</span>
      <span><kbd>p</kbd> props</span>
      <span><kbd>m</kbd> methods</span>
      <span><kbd>e</kbd> events</span>
      <span><kbd>s</kbd> slots</span>
      <span><kbd>c</kbd> css</span>
      <span class="sep">│</span>
      <span><kbd>j</kbd>/<kbd>k</kbd> nav</span>
      <span class="statusbar-cursor"></span>
    </footer>
  </div>
</PageLayout>

<script>
  import "@maxhill/components/m-command-palette";
  import { registerCommand } from "@maxhill/components/m-command";

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ═══════════════════════════════════════
  // SPRING PHYSICS SOLVER
  // ═══════════════════════════════════════
  function spring(from: number, to: number, onUpdate: (v: number) => void, onDone?: () => void) {
    if (reducedMotion) { onUpdate(to); onDone?.(); return; }
    const mass = 1;
    const stiffness = 300;
    const damping = 26;
    let position = from;
    let velocity = 0;
    let lastTime = performance.now();
    let raf: number;

    function step(now: number) {
      const dt = Math.min((now - lastTime) / 1000, 0.064); // cap at ~16fps minimum
      lastTime = now;
      const displacement = position - to;
      const springForce = -stiffness * displacement;
      const dampingForce = -damping * velocity;
      const acceleration = (springForce + dampingForce) / mass;
      velocity += acceleration * dt;
      position += velocity * dt;
      onUpdate(position);

      if (Math.abs(velocity) < 0.5 && Math.abs(position - to) < 0.5) {
        onUpdate(to);
        onDone?.();
      } else {
        raf = requestAnimationFrame(step);
      }
    }
    raf = requestAnimationFrame(step);
    return () => cancelAnimationFrame(raf);
  }

  // ═══════════════════════════════════════
  // BOOT SEQUENCE
  // ═══════════════════════════════════════
  const bootOverlay = document.getElementById('boot-overlay')!;
  const bootText = document.getElementById('boot-text')!;
  const app = document.getElementById('app')!;

  const bootLines = [
    'maxhill/components v2.4.1',
    'loading custom-elements.json ...',
    `found ${document.querySelectorAll('.sidebar-item').length} components`,
    'initializing design system ...',
    'ready.',
  ];

  async function runBoot() {
    if (reducedMotion) {
      bootOverlay.remove();
      app.classList.add('booted');
      return;
    }

    app.classList.add('booting');

    for (const line of bootLines) {
      await typeLine(line);
      await delay(60);
    }

    await delay(150);
    bootOverlay.classList.add('fade-out');
    await delay(400);
    bootOverlay.remove();
    app.classList.remove('booting');
    app.classList.add('booted');
  }

  function typeLine(text: string): Promise<void> {
    return new Promise(resolve => {
      const line = document.createElement('div');
      bootText.appendChild(line);
      let i = 0;
      const interval = setInterval(() => {
        line.textContent = '> ' + text.slice(0, ++i);
        if (i >= text.length) { clearInterval(interval); resolve(); }
      }, 12);
    });
  }

  function delay(ms: number) { return new Promise(r => setTimeout(r, ms)); }

  runBoot();

  // ═══════════════════════════════════════
  // SIDEBAR CURSOR (spring-animated block)
  // ═══════════════════════════════════════
  const sidebarCursor = document.getElementById('sidebar-cursor')!;
  const sidebarItems = document.querySelectorAll('.sidebar-item');
  const componentViews = document.querySelectorAll('.component-view');
  let currentCursorY = 0;
  let cancelSpring: (() => void) | undefined;

  function positionCursor(item: Element, animate = true) {
    const sidebar = item.closest('.sidebar')!;
    const sidebarRect = sidebar.getBoundingClientRect();
    const itemRect = item.getBoundingClientRect();
    const targetY = itemRect.top - sidebarRect.top + sidebar.scrollTop;
    const targetH = itemRect.height;

    sidebarCursor.style.height = `${targetH}px`;

    if (!animate || reducedMotion) {
      sidebarCursor.style.transform = `translateY(${targetY}px)`;
      currentCursorY = targetY;
      return;
    }

    cancelSpring?.();
    cancelSpring = spring(currentCursorY, targetY, (v) => {
      sidebarCursor.style.transform = `translateY(${v}px)`;
    }, () => { currentCursorY = targetY; }) as any;
    currentCursorY = targetY; // set target immediately for next calculation
  }

  // Initialize cursor position
  requestAnimationFrame(() => {
    const activeItem = document.querySelector('.sidebar-item.active');
    if (activeItem) positionCursor(activeItem, false);
  });

  // ═══════════════════════════════════════
  // TAB WIPE TRANSITION
  // ═══════════════════════════════════════
  function wipeIn(panel: Element) {
    if (reducedMotion) return;
    const el = panel as HTMLElement;
    el.animate([
      { clipPath: 'inset(0 100% 0 0)', opacity: 0.6 },
      { clipPath: 'inset(0 0% 0 0)', opacity: 1 },
    ], {
      duration: 200,
      easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
      fill: 'none',
    });
  }

  // ═══════════════════════════════════════
  // NAVIGATION LOGIC
  // ═══════════════════════════════════════
  const paletteDialog = document.getElementById('palette-dialog') as HTMLDialogElement;

  function selectComponent(tagName: string) {
    sidebarItems.forEach(el => {
      const isActive = el.getAttribute('data-component') === tagName;
      el.classList.toggle('active', isActive);
      el.setAttribute('aria-selected', String(isActive));
      if (isActive) positionCursor(el);
    });
    componentViews.forEach(el => el.classList.toggle('active', el.getAttribute('data-component') === tagName));
    const activeView = document.querySelector('.component-view.active .section-panels');
    if (activeView) activeView.scrollTop = 0;
    // Wipe in the new panel content
    const activePanel = document.querySelector('.component-view.active .section-panel.active');
    if (activePanel) wipeIn(activePanel);
  }

  sidebarItems.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-component');
      if (tag) selectComponent(tag);
    });
  });

  function selectSection(sectionId: string, view?: Element | null) {
    const container = view || document.querySelector('.component-view.active');
    if (!container) return;
    container.querySelectorAll('.section-tab').forEach(t => {
      const isActive = t.getAttribute('data-section') === sectionId;
      t.classList.toggle('active', isActive);
      t.setAttribute('aria-selected', String(isActive));
    });
    container.querySelectorAll('.section-panel').forEach(p => {
      const isActive = p.getAttribute('data-section') === sectionId;
      p.classList.toggle('active', isActive);
      if (isActive) wipeIn(p);
    });
    const panels = container.querySelector('.section-panels');
    if (panels) panels.scrollTop = 0;
  }

  document.querySelectorAll('.section-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const sectionId = tab.getAttribute('data-section');
      const view = tab.closest('.component-view');
      if (sectionId) selectSection(sectionId, view);
    });
  });

  // ═══════════════════════════════════════
  // LEADER KEY
  // ═══════════════════════════════════════
  let leaderActive = false;
  let leaderTimeout: ReturnType<typeof setTimeout>;

  const sectionKeyMap: Record<string, string> = {
    o: 'overview', x: 'examples', y: 'keyboard',
    p: 'properties', m: 'methods', e: 'events',
    s: 'slots', c: 'css-parts',
  };

  document.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).tagName === 'INPUT') return;

    if (e.ctrlKey && e.key === 'b') {
      e.preventDefault();
      leaderActive = true;
      document.body.classList.add('leader-active');
      clearTimeout(leaderTimeout);
      leaderTimeout = setTimeout(() => {
        leaderActive = false;
        document.body.classList.remove('leader-active');
      }, 1500);
      return;
    }

    if (leaderActive) {
      leaderActive = false;
      document.body.classList.remove('leader-active');
      clearTimeout(leaderTimeout);

      if (e.key === ' ') {
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('m-command-register', { bubbles: true }));
        paletteDialog.showModal();
        return;
      }

      if (e.key === 'j' || e.key === 'k') {
        e.preventDefault();
        const items = Array.from(sidebarItems);
        const current = items.findIndex(el => el.classList.contains('active'));
        const next = e.key === 'j' ? Math.min(current + 1, items.length - 1) : Math.max(current - 1, 0);
        const tag = items[next]?.getAttribute('data-component');
        if (tag) {
          selectComponent(tag);
          items[next].scrollIntoView({ block: 'nearest' });
        }
        return;
      }

      const sectionId = sectionKeyMap[e.key];
      if (sectionId) {
        e.preventDefault();
        selectSection(sectionId);
      }
    }
  });

  document.addEventListener('m-command-trigger', () => {
    if (paletteDialog.open) paletteDialog.close();
  });

  // Register commands
  const sectionKeys = [
    { keys: "C-b o", id: "section-overview", label: "Overview" },
    { keys: "C-b x", id: "section-examples", label: "Examples" },
    { keys: "C-b y", id: "section-keyboard", label: "Keyboard" },
    { keys: "C-b p", id: "section-properties", label: "Properties" },
    { keys: "C-b m", id: "section-methods", label: "Methods" },
    { keys: "C-b e", id: "section-events", label: "Events" },
    { keys: "C-b s", id: "section-slots", label: "Slots" },
    { keys: "C-b c", id: "section-css-parts", label: "CSS Parts" },
  ];

  sectionKeys.forEach(({ keys, id, label }) => {
    registerCommand({
      id,
      keys,
      preventDefault: true,
      customCommand: () => {
        const sectionId = id.replace('section-', '');
        selectSection(sectionId);
      }
    });
    const el = document.getElementById(`command_${id}`);
    if (el) el.dataset.label = `Show ${label}`;
  });

  sidebarItems.forEach((btn) => {
    const tag = btn.getAttribute('data-component')!;
    registerCommand({
      id: `go-to-${tag}`,
      command: "custom",
      customCommand: () => {
        selectComponent(tag);
        paletteDialog.close();
      }
    });
    const el = document.getElementById(`command_go-to-${tag}`);
    if (el) el.dataset.label = `Navigate to ${tag}`;
  });
</script>

<style>
  :global(.proto-v6-page) {
    padding-top: var(--menu-height);
  }

  .proto-nav {
    position: fixed;
    bottom: 60px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    gap: var(--size-1);
    align-items: center;
    padding: var(--size-1) var(--size-2);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-stroke);
    font-size: var(--font-size-0);

    .proto-label {
      color: var(--color-destructive-text-colorful);
      font-weight: bold;
      font-family: var(--ff-display);
    }

    a {
      padding: var(--size-00) var(--size-1);
      text-decoration: none;
      color: var(--color-text-softer);
      &.active {
        background: var(--color-primary-fill-softer);
        color: var(--color-primary-text-colorful);
      }
    }
  }

  /* ═══════════════════════════════════════
     BOOT OVERLAY
     ═══════════════════════════════════════ */

  .boot-overlay {
    position: fixed;
    inset: 0;
    top: var(--menu-height);
    z-index: 900;
    background: oklch(0.05 0.01 155);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;

    &.fade-out {
      animation: boot-fade 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  }

  .boot-scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 2px,
      oklch(0 0 0 / 0.15) 2px,
      oklch(0 0 0 / 0.15) 4px
    );
    pointer-events: none;
    animation: scanline-flicker 100ms steps(2) infinite;
  }

  .boot-text {
    font-family: var(--ff-display);
    font-size: var(--font-size-0);
    color: var(--color-primary-text-colorful);
    margin: 0;
