---
import PageLayout from "../../components/layouts/PageLayout.astro";
import ComponentsLayout from "../../components/layouts/ComponentsLayout.astro";
import CodeExample from "../../components/CodeExample.astro";
import RefPanel from "../../components/RefPanel.astro";
import { SECTIONS } from "../../components/layouts/sections";
import { getComponentData, getAllComponentTagNames } from "../../utils/get-component-data";
import { getExamplesForComponent } from "../../utils/get-component-examples";
import { marked } from "marked";

export function getStaticPaths() {
    const tagNames = getAllComponentTagNames();
    return tagNames.map((tagName) => ({
        params: { component: tagName },
        props: { tagName },
    }));
}

const { tagName } = Astro.props;
const comp = getComponentData(tagName);
const examples = getExamplesForComponent(tagName);

if (!comp) {
    return Astro.redirect("/components");
}

const firstExample = examples[0];
const restExamples = examples.slice(1);

function slugToTitle(slug: string): string {
    return slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

const sectionCtx = { comp, examples };
const sections = SECTIONS.map((sec) => ({
    ...sec,
    disabled: sec.isEmpty ? sec.isEmpty(sectionCtx) : false,
}));
---

<PageLayout title={tagName} bodyClass="component-page">
    <ComponentsLayout currentComponent={tagName} title={tagName}>
        <article class="component-view">
            <header class="component-header">
                <span class="component-name">&lt;{tagName}&gt;</span>
                <span class="badges">
                    {comp.formAssociated && <span class="badge badge--form">FORM</span>}
                    {comp.slots.length > 0 && <span class="badge">{comp.slots.length} SLOTS</span>}
                    {comp.properties.length > 0 && <span class="badge">{comp.properties.length} PROPS</span>}
                    {comp.events.length > 0 && <span class="badge">{comp.events.length} EVENTS</span>}
                </span>
            </header>

            <m-tab-list label="Component sections" transition="terminal-wipe" class="section-tabs">
                {sections.map((sec) => (
                    <m-tab panel={sec.id} disabled={sec.disabled || undefined}>
                        {sec.label.toLowerCase()}
                    </m-tab>
                ))}

                <!-- Overview panel -->
                <m-tab-panel name="overview">
                    <div class="panel-inner typesetting">
                        {comp.description && comp.description !== "—" && (
                            <div class="typesetting" set:html={marked.parse(comp.description)} />
                        )}
                        {firstExample && (
                            <div class="example-block">
                                <h2 class="h6">{slugToTitle(firstExample.slug)}</h2>
                                {firstExample.explanation && (
                                    <div class="typesetting" set:html={marked.parse(firstExample.explanation)} />
                                )}
                                <CodeExample html={firstExample.html} css={firstExample.css} js={firstExample.js} />
                            </div>
                        )}
                    </div>
                </m-tab-panel>

                <!-- Examples panel -->
                <m-tab-panel name="examples">
                    <div class="panel-inner">
                        {restExamples.map((example) => (
                            <div class="example-block typesetting">
                                <h2 class="h6">{slugToTitle(example.slug)}</h2>
                                {example.explanation && (
                                    <div class="typesetting" set:html={marked.parse(example.explanation)} />
                                )}
                                <CodeExample html={example.html} css={example.css} js={example.js} />
                            </div>
                        ))}
                    </div>
                </m-tab-panel>

                <!-- Properties panel -->
                <m-tab-panel name="properties">
                    <RefPanel
                        columns={["NAME", "TYPE", "DEFAULT"]}
                        items={comp.properties.map((p) => ({ name: p.name, type: p.type, default: p.default || "—", description: p.description }))}
                    />
                </m-tab-panel>

                <!-- Methods panel -->
                <m-tab-panel name="methods">
                    <RefPanel
                        columns={["NAME", "RETURNS"]}
                        items={comp.methods.map((m) => ({ name: m.name, type: m.type, description: m.description }))}
                    />
                </m-tab-panel>

                <!-- Events panel -->
                <m-tab-panel name="events">
                    <RefPanel
                        columns={["NAME", "DETAIL TYPE"]}
                        items={comp.events.map((e) => ({ name: e.name, type: e.type, description: e.description }))}
                    />
                </m-tab-panel>

                <!-- Slots panel -->
                <m-tab-panel name="slots">
                    <RefPanel
                        columns={["NAME"]}
                        items={comp.slots.map((s) => ({ name: s.name || "(default)", description: s.description }))}
                    />
                </m-tab-panel>

                <!-- CSS Parts panel -->
                <m-tab-panel name="css-parts">
                    <RefPanel
                        columns={["NAME"]}
                        items={comp.cssParts.map((p) => ({ name: `::part(${p.name})`, description: p.description }))}
                    />
                </m-tab-panel>
            </m-tab-list>
        </article>
    </ComponentsLayout>
</PageLayout>

<style>

    .component-view {
        display: grid;
        grid-template-rows: auto 1fr;
        min-height: 0;
        overflow: hidden;
        height: 100%;
    }

    /* ═══════════════════════════════════════
       COMPONENT HEADER
       ═══════════════════════════════════════ */

    .component-header {
        padding: var(--size-4) var(--size-4) var(--size-3);
        border-bottom: var(--border-width) solid var(--color-stroke);
        display: flex;
        align-items: baseline;
        gap: var(--size-3);
        background: var(--color-surface);

        @media (width <= 768px) {
            padding: var(--size-3) var(--size-2);
            flex-wrap: wrap;
        }
    }

    .component-name {
        font-family: var(--ff-display);
        font-size: var(--font-size-4);
        line-height: 1;
        color: var(--color-primary-text-colorful);
        letter-spacing: -0.01em;

        @media (width <= 768px) {
            font-size: var(--font-size-3);
        }
    }

    .badges {
        display: flex;
        flex-wrap: wrap;
        gap: var(--size-1);
        margin-left: auto;
        align-self: center;
    }

    .badge {
        font-size: var(--font-size-0);
        padding: var(--size-1) var(--size-1);
        border: var(--border-width) solid var(--color-stroke);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-text-softer);
        font-family: var(--ff-display);
    }

    .badge--form {
        border-color: var(--color-primary-fill-mid);
        color: var(--color-primary-text-colorful);
    }

    /* ═══════════════════════════════════════
       TAB LIST
       ═══════════════════════════════════════ */

    .section-tabs {
        min-height: 0;
        overflow: hidden;
        --_padding-inline: var(--size-2);
        --_padding-block: var(--size-1);

        m-tab {
            font-size: var(--font-size-1);
            color: var(--color-text-softer);
            white-space: nowrap;
            text-transform: lowercase;
        }

        m-tab[aria-selected="true"] {
            color: var(--color-primary-text-colorful);
        }

        m-tab[disabled] {
            opacity: 0.35;
            cursor: not-allowed;
        }

        m-tab-panel {
            overflow-y: auto;
            max-height: 100%;
        }
    }

    /* ═══════════════════════════════════════
       PANELS
       ═══════════════════════════════════════ */

    .panel-inner {
        padding: var(--size-4) var(--size-5) var(--size-6);
        overflow-x: auto;

        @media (width <= 768px) {
            padding: var(--size-3) var(--size-2) var(--size-4);
        }
    }

    .typesetting > .typesetting {
        max-width: var(--size-content-3);
    }

    .example-block {
        padding-top: var(--size-4);

        &:not(:last-child) {
            padding-bottom: var(--size-4);
            border-bottom: var(--border);
        }
    }

    /* ═══════════════════════════════════════
       API REFERENCE (man-page style)
       — styles moved to RefPanel.astro
       ═══════════════════════════════════════ */
</style>
