---
import PageLayout from "../../components/layouts/PageLayout.astro";
import ComponentsLayout from "../../components/layouts/ComponentsLayout.astro";
import CodeExample from "../../components/CodeExample.astro";
import { getComponentData, getAllComponentTagNames } from "../../utils/get-component-data";
import { getExamplesForComponent } from "../../utils/get-component-examples";
import { marked } from "marked";

export function getStaticPaths() {
    const tagNames = getAllComponentTagNames();
    return tagNames.map((tagName) => ({
        params: { component: tagName },
        props: { tagName },
    }));
}

const { tagName } = Astro.props;
const comp = getComponentData(tagName);
const examples = getExamplesForComponent(tagName);

if (!comp) {
    return Astro.redirect("/components");
}

const firstExample = examples[0];
const restExamples = examples.slice(1);

const sections = [
    { id: "overview", label: "overview", disabled: false },
    { id: "examples", label: "examples", disabled: restExamples.length === 0 },
    { id: "properties", label: "properties", disabled: comp.properties.length === 0 },
    { id: "methods", label: "methods", disabled: comp.methods.length === 0 },
    { id: "events", label: "events", disabled: comp.events.length === 0 },
    { id: "slots", label: "slots", disabled: comp.slots.length === 0 },
    { id: "css-parts", label: "css parts", disabled: comp.cssParts.length === 0 },
];
---

<PageLayout title={tagName} bodyClass="component-page">
    <ComponentsLayout currentComponent={tagName} title={tagName}>
        <article class="component-view">
            <header class="component-header">
                <span class="component-name">&lt;{tagName}&gt;</span>
                <span class="badges">
                    {comp.formAssociated && <span class="badge badge--form">FORM</span>}
                    {comp.slots.length > 0 && <span class="badge">{comp.slots.length} SLOTS</span>}
                    {comp.properties.length > 0 && <span class="badge">{comp.properties.length} PROPS</span>}
                    {comp.events.length > 0 && <span class="badge">{comp.events.length} EVENTS</span>}
                </span>
            </header>

            <m-tab-list label="Component sections" transition="terminal-wipe" class="section-tabs">
                {sections.map((sec) => (
                    <m-tab panel={sec.id} disabled={sec.disabled || undefined}>
                        {sec.label}
                    </m-tab>
                ))}

                <!-- Overview panel -->
                <m-tab-panel name="overview">
                    <div class="panel-inner typesetting">
                        {comp.description && comp.description !== "—" && (
                            <div class="typesetting" set:html={marked.parse(comp.description)} />
                        )}
                        {firstExample && (
                            <>
                                {firstExample.explanation && (
                                    <div class="typesetting" set:html={marked.parse(firstExample.explanation)} />
                                )}
                                <CodeExample html={firstExample.html} css={firstExample.css} js={firstExample.js} />
                            </>
                        )}
                    </div>
                </m-tab-panel>

                <!-- Examples panel -->
                <m-tab-panel name="examples">
                    <div class="panel-inner typesetting">
                        {restExamples.map((example) => (
                            <div class="example-block">
                                {example.explanation && (
                                    <div class="typesetting" set:html={marked.parse(example.explanation)} />
                                )}
                                <CodeExample html={example.html} css={example.css} js={example.js} />
                            </div>
                        ))}
                    </div>
                </m-tab-panel>

                <!-- Properties panel -->
                <m-tab-panel name="properties">
                    <div class="panel-inner">
                        <table>
                            <thead><tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                            <tbody>
                                {comp.properties.map((prop) => (
                                    <tr>
                                        <td class="cell-name">{prop.name}</td>
                                        <td class="cell-type">{prop.type}</td>
                                        <td class="cell-default">{prop.default}</td>
                                        <td>{prop.description}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </m-tab-panel>

                <!-- Methods panel -->
                <m-tab-panel name="methods">
                    <div class="panel-inner">
                        <table>
                            <thead><tr><th>Name</th><th>Type</th><th>Description</th></tr></thead>
                            <tbody>
                                {comp.methods.map((method) => (
                                    <tr>
                                        <td class="cell-name">{method.name}</td>
                                        <td class="cell-type">{method.type}</td>
                                        <td>{method.description}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </m-tab-panel>

                <!-- Events panel -->
                <m-tab-panel name="events">
                    <div class="panel-inner">
                        <table>
                            <thead><tr><th>Name</th><th>Detail Type</th><th>Description</th></tr></thead>
                            <tbody>
                                {comp.events.map((event) => (
                                    <tr>
                                        <td class="cell-name">{event.name}</td>
                                        <td class="cell-type">{event.type}</td>
                                        <td>{event.description}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </m-tab-panel>

                <!-- Slots panel -->
                <m-tab-panel name="slots">
                    <div class="panel-inner">
                        <table>
                            <thead><tr><th>Name</th><th>Description</th></tr></thead>
                            <tbody>
                                {comp.slots.map((slot) => (
                                    <tr>
                                        <td class="cell-name">{slot.name || "(default)"}</td>
                                        <td>{slot.description}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </m-tab-panel>

                <!-- CSS Parts panel -->
                <m-tab-panel name="css-parts">
                    <div class="panel-inner">
                        <table>
                            <thead><tr><th>Name</th><th>Description</th></tr></thead>
                            <tbody>
                                {comp.cssParts.map((part) => (
                                    <tr>
                                        <td class="cell-name">::part({part.name})</td>
                                        <td>{part.description}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </m-tab-panel>
            </m-tab-list>
        </article>
    </ComponentsLayout>
</PageLayout>

<style>
    :global(.component-page) {
        padding-top: var(--menu-height);
    }

    .component-view {
        display: grid;
        grid-template-rows: auto 1fr;
        min-height: 0;
        overflow: hidden;
        height: 100%;
    }

    /* ═══════════════════════════════════════
       COMPONENT HEADER
       ═══════════════════════════════════════ */

    .component-header {
        padding: var(--size-4) var(--size-4) var(--size-3);
        border-bottom: var(--border-width) solid var(--color-stroke);
        display: flex;
        align-items: baseline;
        gap: var(--size-3);
        background: color-mix(in oklch, var(--color-surface) 97%, var(--color-primary-fill-mid));

        @media (width <= 768px) {
            padding: var(--size-3) var(--size-2);
            flex-wrap: wrap;
        }
    }

    .component-name {
        font-family: var(--ff-display);
        font-size: var(--font-size-4);
        line-height: 1;
        color: var(--color-primary-text-colorful);
        letter-spacing: -0.01em;

        @media (width <= 768px) {
            font-size: var(--font-size-3);
        }
    }

    .badges {
        display: flex;
        flex-wrap: wrap;
        gap: var(--size-1);
        margin-left: auto;
        align-self: center;
    }

    .badge {
        font-size: var(--font-size-00);
        padding: 2px var(--size-1);
        border: var(--border-width) solid var(--color-stroke);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-text-softer);
        font-family: var(--ff-display);
    }

    .badge--form {
        border-color: var(--color-primary-fill-mid);
        color: var(--color-primary-text-colorful);
    }

    /* ═══════════════════════════════════════
       TAB LIST
       ═══════════════════════════════════════ */

    .section-tabs {
        min-height: 0;
        overflow: hidden;
        --_padding-inline: var(--size-2);
        --_padding-block: var(--size-1);

        m-tab {
            font-size: var(--font-size-1);
            color: var(--color-text-softer);
            white-space: nowrap;
            text-transform: lowercase;
        }

        m-tab[aria-selected="true"] {
            color: var(--color-primary-text-colorful);
        }

        m-tab[disabled] {
            opacity: 0.35;
            cursor: not-allowed;
        }

        m-tab-panel {
            overflow-y: auto;
            max-height: 100%;
        }
    }

    /* ═══════════════════════════════════════
       PANELS
       ═══════════════════════════════════════ */

    .panel-inner {
        padding: var(--size-4) var(--size-5) var(--size-6);
        overflow-x: auto;

        @media (width <= 768px) {
            padding: var(--size-3) var(--size-2) var(--size-4);
        }

        > .typesetting {
            max-width: var(--size-content-3);
        }
    }

    .example-block {
        margin-bottom: var(--size-5);
    }

    /* ═══════════════════════════════════════
       TABLES
       ═══════════════════════════════════════ */

    table {
        width: 100%;
        min-width: 480px;
        border-collapse: collapse;
        font-size: var(--font-size-0);

        th, td {
            text-align: left;
            padding: var(--size-00) var(--size-2) var(--size-00) 0;
            border-bottom: var(--border-width) solid color-mix(in oklch, var(--color-stroke) 50%, transparent);
        }

        th {
            font-weight: var(--font-weight-medium);
            color: var(--color-text-softer);
            text-transform: uppercase;
            font-size: var(--font-size-0);
            letter-spacing: 0.08em;
            padding-bottom: var(--size-1);
            font-family: var(--ff-display);
        }

        tr:hover td {
            background: var(--color-primary-fill-softer);
        }
    }

    .cell-name {
        font-weight: var(--font-weight-medium);
        color: var(--color-primary-text-colorful);
        white-space: nowrap;
    }

    .cell-type {
        color: var(--color-text-softer);
        white-space: nowrap;
        font-size: var(--font-size-0);
    }

    .cell-default {
        color: var(--color-text-softer);
        font-style: italic;
        font-size: var(--font-size-0);
    }
</style>
