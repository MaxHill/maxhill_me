---
import PageLayout from "../../components/layouts/PageLayout.astro";
import ComponentsLayout from "../../components/layouts/ComponentsLayout.astro";
import { getAllComponentTagNames } from "../../utils/get-component-data";

const title = "Components";
const allComponents = getAllComponentTagNames();
---

<PageLayout title={title} bodyClass="component-page">
    <ComponentsLayout title={title} currentComponent="">
        <div class="empty-selection">
            <div class="empty-inner">
                <h1 class="h5">Components</h1>
                <p>{allComponents.length} components available</p>
                <p class="hint">Select a component from the sidebar, or press <kbd>space</kbd> <kbd>space</kbd> to open the command palette.</p>
            </div>
        </div>
    </ComponentsLayout>
</PageLayout>

<style>

    .empty-selection {
        display: grid;
        place-items: center;
        height: 100%;
        padding: var(--size-fluid-3);
    }

    .empty-inner {
        text-align: center;
        color: var(--color-text-softer);
        display: grid;
        gap: var(--size-2);
        justify-items: center;
    }

    .empty-inner h1 {
        color: var(--color-text);
    }

    .hint {
        font-size: var(--font-size-0);
        max-width: var(--size-content-2);
    }

    kbd {
        font-family: var(--ff-display);
        font-size: var(--font-size-0);
        padding: var(--size-000) var(--size-1);
        border: var(--border-width) solid var(--color-stroke);
        background: var(--color-surface);
    }
</style>
