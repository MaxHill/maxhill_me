{
  "name": "@maxhill/auth",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts run ../../vps/auth/auth.dev.json",
    "build": "bun build --compile --target=bun-linux-x64 ./src/index.ts --outfile=./dist/auth-exe",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@openauthjs/openauth": "^0.4.3",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.9.3"
  }
}
